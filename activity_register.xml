<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="إنشاء حساب جديد"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary_dark"
        android:layout_marginBottom="24dp" />

    <EditText
        android:id="@+id/etDisplayName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اسمك الظاهر (مثال: أحمد)"
        android:inputType="text"
        android:background="@color/white"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etUniqueId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="اختر معرّفاً فريداً (أحرف إنجليزية وأرقام فقط)"
        android:inputType="text"
        android:background="@color/white"
        android:padding="14dp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="كلمة المرور (6 أحرف على الأقل)"
        android:inputType="textPassword"
        android:background="@color/white"
        android:padding="14dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="إنشاء الحساب"
        android:backgroundTint="@color/primary" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>
